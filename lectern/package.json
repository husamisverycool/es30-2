{
  "name": "lectern",
  "version": "1.0.0",
  "description": "Lectern MVP: a professor-controlled course tutor",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/to-artifact.mjs",
    "typecheck": "tsc --noEmit -p .",
    "validate": "tsx scripts/validate-content.ts",
    "zip": "npm run build && node scripts/zip-netlify.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "preact": "^11.0.0"
  },
  "private": true,
  "type": "module"
}
